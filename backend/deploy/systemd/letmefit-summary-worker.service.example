[Unit]
Description=LetMeFit Conversation Summary Worker
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/letmefit/backend
EnvironmentFile=/opt/letmefit/backend/.env.production
ExecStart=/opt/letmefit/backend/.venv/bin/python scripts/process_conversation_summaries.py --loop
Restart=always
RestartSec=5
TimeoutStopSec=60
User=letmefit
Group=letmefit

[Install]
WantedBy=multi-user.target
