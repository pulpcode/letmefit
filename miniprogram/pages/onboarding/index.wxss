.onboarding-page {
  display: flex;
  flex-direction: column;
}

.top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.step-label {
  margin-bottom: 12rpx;
  color: #0b8f7a;
  font-size: 24rpx;
  font-weight: 700;
}

.skip {
  min-height: 64rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
}

.progress {
  margin: 28rpx 0 36rpx;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4efec;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #0b8f7a;
}

.option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.option {
  min-height: 160rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #18332f;
  font-weight: 700;
}

.selected {
  border-color: rgba(11, 143, 122, 0.45);
  background: #e7f5f1;
  color: #0b6f60;
}

.form {
  padding: 28rpx;
}

.sex-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.sex-chip {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f3f8f6;
  color: #58716c;
  font-size: 24rpx;
}

.field-line {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #eef5f3;
}

.field-line text {
  color: #58716c;
}

.field-line input {
  flex: 1;
  text-align: right;
  color: #18332f;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity {
  padding: 24rpx;
}

.activity-title {
  font-weight: 700;
}

.activity-desc {
  margin-top: 8rpx;
  color: #7a8b87;
  font-size: 24rpx;
}

.bottom-actions {
  margin-top: auto;
  padding-top: 48rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.bottom-actions button:only-child {
  grid-column: 1 / -1;
}

