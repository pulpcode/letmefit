page {
  min-height: 100%;
  background: #f7fbfa;
  color: #18332f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: 1.2;
  font-size: 28rpx;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 56rpx;
}

.safe-tab-page {
  padding-bottom: 140rpx;
}

.card {
  border: 1rpx solid rgba(17, 120, 103, 0.08);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(18, 79, 70, 0.06);
}

.primary-btn,
.secondary-btn,
.danger-btn,
.ghost-btn {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.primary-btn {
  color: #ffffff;
  background: #0b8f7a;
}

.secondary-btn {
  color: #0b6f60;
  background: #e7f5f1;
}

.danger-btn {
  color: #a33a25;
  background: #fff0ea;
}

.ghost-btn {
  color: #65827c;
  background: transparent;
}

.muted {
  color: #7a8b87;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #18332f;
}

.field {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe9e5;
  border-radius: 16rpx;
  background: #ffffff;
}

.input {
  width: 100%;
  height: 88rpx;
  color: #18332f;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #0b6f60;
  background: #e7f5f1;
  font-size: 24rpx;
}

.low-confidence {
  color: #b45f06;
  background: #fff6df;
}
