APP_NAME=LetMeFit Backend
APP_VERSION=0.1.0
ENVIRONMENT=production
API_PREFIX=/v1

MYSQL_DATABASE=letmefit
MYSQL_USER=letmefit
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
REDIS_PASSWORD=replace-with-strong-redis-password

DATABASE_URL=mysql+pymysql://letmefit:replace-with-strong-mysql-password@127.0.0.1:3306/letmefit
REDIS_URL=redis://:replace-with-strong-redis-password@127.0.0.1:6379/0

JWT_SECRET_KEY=replace-with-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

SMS_PROVIDER=aliyun
SMS_COUNTRY_CODE=86
SMS_SEND_COOLDOWN_SECONDS=60
SMS_EXPIRES_IN_SECONDS=300
SMS_MAX_FAILED_ATTEMPTS=5
SMS_FAILED_LOCK_SECONDS=600

ALIYUN_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SCHEME_NAME=replace-with-scheme-name
ALIYUN_SMS_SIGN_NAME=replace-with-sign-name
ALIYUN_SMS_TEMPLATE_CODE=replace-with-template-code

AI_PROVIDER=bailian
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_SCHEMA_REPAIR_RETRIES=1
AI_TEMPERATURE=0.1
CONVERSATION_CONTEXT_RECENT_MESSAGES=8
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=16
CONVERSATION_SUMMARY_MAX_CHARS=2000

ASR_PROVIDER=mock
VISION_PROVIDER=mock
DASHSCOPE_ASR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
DASHSCOPE_TASK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/tasks
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_ASR_LANGUAGE_HINTS=zh,en
DASHSCOPE_ASR_POLL_INTERVAL_SECONDS=0.5
DASHSCOPE_ASR_MAX_WAIT_SECONDS=20

BAILIAN_API_KEY=replace-with-bailian-api-key
DASHSCOPE_API_KEY=replace-with-dashscope-api-key-or-leave-empty
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

MEDIA_UPLOAD_DIR=./var/uploads
MEDIA_PUBLIC_BASE_URL=https://www.letmefit.cloud
MEDIA_MAX_UPLOAD_BYTES=10485760
