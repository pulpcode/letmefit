.chat-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f7fbfa;
}

.chat-bg,
.chat-mask {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
}

.chat-bg {
  opacity: 0.22;
}

.chat-mask {
  background: rgba(247, 251, 250, 0.88);
}

.messages {
  position: relative;
  z-index: 1;
  height: calc(100vh - 190rpx);
  padding: 28rpx 28rpx 220rpx;
}

.welcome {
  margin-top: 40rpx;
  padding: 32rpx;
  text-align: center;
}

.welcome-avatar {
  width: 180rpx;
  height: 180rpx;
}

.welcome-title {
  margin-top: 8rpx;
  color: #18332f;
  font-size: 34rpx;
  font-weight: 800;
}

.welcome-text {
  margin-top: 12rpx;
  color: #7a8b87;
  line-height: 1.5;
}

.message-row {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.55;
  word-break: break-word;
}

.assistant .bubble {
  color: #18332f;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(18, 79, 70, 0.06);
}

.user .bubble {
  color: #ffffff;
  background: #0b8f7a;
}

.pending-list {
  margin-top: 16rpx;
}

.unsupported {
  margin: 24rpx 0;
  padding: 24rpx;
  color: #7a8b87;
}

.bottom-anchor {
  height: 2rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 18rpx 24rpx 34rpx;
  border-top: 1rpx solid rgba(17, 120, 103, 0.08);
  background: rgba(255, 255, 255, 0.96);
}

.tool-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.tool {
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #0b6f60;
  background: #e7f5f1;
  font-size: 24rpx;
  font-weight: 600;
}

.tool.recording {
  color: #a33a25;
  background: #fff0ea;
}

.input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.text-input {
  flex: 1;
  height: 78rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #f3f8f6;
}

.send-btn {
  width: 128rpx;
  height: 78rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #0b8f7a;
  font-weight: 700;
}

