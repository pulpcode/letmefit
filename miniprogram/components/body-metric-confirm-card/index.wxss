.confirm-card {
  padding: 28rpx;
  margin: 24rpx 0;
}

.confirm-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  color: #18332f;
  font-size: 30rpx;
  font-weight: 700;
}

.hint {
  margin-top: 8rpx;
  color: #7a8b87;
  font-size: 24rpx;
}

.confidence {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #0b6f60;
  background: #e7f5f1;
  font-size: 22rpx;
}

.metric-list {
  margin-top: 20rpx;
  border-top: 1rpx solid #eef5f3;
}

.input-line {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #eef5f3;
}

.input-label {
  width: 150rpx;
  color: #65827c;
  font-size: 24rpx;
}

.input-label.low {
  color: #b45f06;
}

.line-input {
  flex: 1;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f7fbfa;
}

.warnings {
  margin-top: 18rpx;
  font-size: 24rpx;
}

.actions {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 14rpx;
}

.small {
  min-height: 76rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
}

