<view class="page safe-tab-page profile-page">
  <view class="header card">
    <image class="avatar" src="{{agentAvatar === 'female' ? '/assets/images/female-fit-agent.png' : '/assets/images/male-fit-agent.png'}}" mode="aspectFit" />
    <view>
      <view class="section-title">我的档案</view>
      <view class="muted">{{profileCompleted ? '基础档案已完成' : '基础档案待完善'}}</view>
    </view>
  </view>

  <view class="form card">
    <view class="field-line">
      <text>年龄</text>
      <input value="{{profile.age}}" data-field="age" bindinput="onNumberInput" type="number" placeholder="30" />
    </view>
    <view class="field-line">
      <text>性别</text>
      <picker mode="selector" range="{{sexOptions}}" range-key="label" value="{{sexIndex}}" bindchange="onSexChange">
        <view>{{sexOptions[sexIndex].label}}</view>
      </picker>
    </view>
    <view class="field-line">
      <text>身高 cm</text>
      <input value="{{profile.height_cm}}" data-field="height_cm" bindinput="onNumberInput" type="digit" placeholder="175" />
    </view>
    <view class="field-line">
      <text>当前体重 kg</text>
      <input value="{{profile.current_weight_kg}}" data-field="current_weight_kg" bindinput="onNumberInput" type="digit" placeholder="72.4" />
    </view>
    <view class="field-line">
      <text>目标体重 kg</text>
      <input value="{{profile.target_weight_kg}}" data-field="target_weight_kg" bindinput="onNumberInput" type="digit" placeholder="可选" />
    </view>
    <view class="field-line">
      <text>活动水平</text>
      <picker mode="selector" range="{{activityOptions}}" range-key="label" value="{{activityIndex}}" bindchange="onActivityChange">
        <view>{{activityOptions[activityIndex].label}}</view>
      </picker>
    </view>
    <view class="field-line">
      <text>主要目标</text>
      <picker mode="selector" range="{{goalOptions}}" range-key="label" value="{{goalIndex}}" bindchange="onGoalChange">
        <view>{{goalOptions[goalIndex].label}}</view>
      </picker>
    </view>
  </view>

  <view class="agent-card card">
    <view class="card-title">Agent 形象</view>
    <view class="agent-options">
      <view class="agent-option {{agentAvatar === 'female' ? 'selected' : ''}}" data-value="female" bindtap="onAgentTap">
        <image src="/assets/images/female-fit-agent.png" mode="aspectFit" />
        <text>女性 Agent</text>
      </view>
      <view class="agent-option {{agentAvatar === 'male' ? 'selected' : ''}}" data-value="male" bindtap="onAgentTap">
        <image src="/assets/images/male-fit-agent.png" mode="aspectFit" />
        <text>男性 Agent</text>
      </view>
    </view>
  </view>

  <button class="primary-btn save" loading="{{saving}}" bindtap="onSave">保存档案</button>
  <button class="danger-btn logout" bindtap="onLogout">退出登录</button>
</view>

