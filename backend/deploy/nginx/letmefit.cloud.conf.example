server {
    listen 80;
    server_name www.letmefit.cloud letmefit.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/letmefit;
    }

    location / {
        return 301 https://www.letmefit.cloud$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name letmefit.cloud;

    ssl_certificate /etc/nginx/ssl/letmefit.cloud/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/letmefit.cloud/privkey.pem;

    return 301 https://www.letmefit.cloud$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.letmefit.cloud;

    ssl_certificate /etc/nginx/ssl/letmefit.cloud/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/letmefit.cloud/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:LetMeFitSSL:10m;
    ssl_prefer_server_ciphers off;

    client_max_body_size 20m;

    access_log /var/log/nginx/letmefit.access.log;
    error_log /var/log/nginx/letmefit.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
