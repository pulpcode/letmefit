<view class="page safe-tab-page records-page">
  <view class="top">
    <view>
      <view class="section-title">今日记录</view>
      <view class="muted">{{date}}</view>
    </view>
    <button class="secondary-btn small" bindtap="goSummary">每日总结</button>
  </view>

  <button class="primary-btn record-entry" bindtap="goChat">继续记录</button>

  <view class="group">
    <view class="group-title">餐食</view>
    <view wx:if="{{!meals.length}}" class="empty card">还没有餐食记录</view>
    <view wx:for="{{meals}}" wx:key="id" class="record card">
      <view class="record-title">{{item.meal_type}} · {{item.total_calories || '--'}} kcal</view>
      <view class="record-sub">蛋白 {{item.total_protein_g || '--'}} g · 碳水 {{item.total_carbs_g || '--'}} g · 脂肪 {{item.total_fat_g || '--'}} g</view>
      <view class="foods">
        <text wx:for="{{item.items}}" wx:key="id" class="food">{{item.name}} {{item.portion_text || ''}}</text>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">身体指标</view>
    <view wx:if="{{!bodyMetrics.length}}" class="empty card">还没有身体指标记录</view>
    <view wx:for="{{bodyMetrics}}" wx:key="id" class="record card">
      <view class="record-title">体重 {{item.weight_kg || '--'}} kg</view>
      <view class="record-sub">体脂 {{item.body_fat_percentage || '--'}}% · BMI {{item.bmi || '--'}}</view>
    </view>
  </view>
</view>

