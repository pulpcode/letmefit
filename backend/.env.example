APP_NAME=LetMeFit Backend
APP_VERSION=0.1.0
ENVIRONMENT=local
API_PREFIX=/v1

MYSQL_DATABASE=letmefit
MYSQL_USER=letmefit
MYSQL_PASSWORD=letmefit_dev_password
MYSQL_ROOT_PASSWORD=letmefit_root_dev_password
REDIS_PASSWORD=letmefit_redis_dev_password

DATABASE_URL=mysql+pymysql://letmefit:letmefit_dev_password@127.0.0.1:3306/letmefit
REDIS_URL=redis://:letmefit_redis_dev_password@127.0.0.1:6379/0

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

SMS_PROVIDER=mock
SMS_MOCK_CODE=123456
SMS_COUNTRY_CODE=86
SMS_SEND_COOLDOWN_SECONDS=60
SMS_EXPIRES_IN_SECONDS=300
SMS_MAX_FAILED_ATTEMPTS=5
SMS_FAILED_LOCK_SECONDS=600

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
