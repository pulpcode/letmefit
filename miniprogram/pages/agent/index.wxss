.agent-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f9fafb;
}

.chat-bg,
.chat-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.chat-mask {
  background: rgba(255, 255, 255, 0.86);
}

.chat-header {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 3;
  height: calc(176rpx + env(safe-area-inset-top));
  padding: calc(48rpx + env(safe-area-inset-top)) 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18rpx);
  border-bottom: 2rpx solid rgba(229, 231, 235, 0.7);
}

.agent-mini-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.agent-mini-avatar image,
.bubble-avatar,
.empty-chat image {
  width: 100%;
  height: 100%;
}

.chat-header view:last-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chat-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.chat-subtitle {
  color: #6a7282;
  font-size: 22rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-scroll {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(176rpx + env(safe-area-inset-top));
  bottom: calc(212rpx + env(safe-area-inset-bottom));
  z-index: 1;
}

.message-list {
  padding: 32rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.empty-chat {
  margin: 80rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #6a7282;
  text-align: center;
  font-size: 28rpx;
  line-height: 42rpx;
}

.empty-chat image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 9999rpx;
}

.message-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.bubble-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.bubble {
  max-width: 552rpx;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #101828;
  word-break: break-word;
}

.assistant .bubble {
  background: rgba(255, 255, 255, 0.94);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.user .bubble {
  color: #ffffff;
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
  border-top-right-radius: 8rpx;
}

.pending-wrap {
  padding-left: 80rpx;
}

.bottom-anchor {
  height: 2rpx;
}

.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #e5e7eb;
  backdrop-filter: blur(18rpx);
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tool-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 9999rpx;
  background: #f3f4f6;
  color: #4a5565;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-btn.active {
  background: #fff4e6;
  color: #ff6b35;
}

.send-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  background: #f3f4f6;
  padding: 0 28rpx;
  color: #101828;
  font-size: 28rpx;
}

.send-btn {
  width: 104rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn.disabled {
  opacity: 0.5;
}
