.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 32rpx;
}

.hero {
  position: relative;
  min-height: 360rpx;
  padding-top: 40rpx;
}

.brand {
  font-size: 56rpx;
  font-weight: 800;
  color: #0b6f60;
}

.subtitle {
  margin-top: 16rpx;
  max-width: 420rpx;
  color: #65827c;
  line-height: 1.6;
}

.agent {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 250rpx;
  height: 250rpx;
}

.form {
  padding: 32rpx;
}

.code-row {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.code-field {
  flex: 1;
}

.code-btn {
  width: 210rpx;
}

.login-btn {
  margin-top: 28rpx;
}

.privacy {
  margin-top: 24rpx;
  color: #7a8b87;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

