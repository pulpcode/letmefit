<view class="page login-page">
  <view class="hero">
    <view class="brand">LetMeFit</view>
    <view class="subtitle">记录饮食、身体指标和每日状态</view>
    <image class="agent" src="/assets/images/female-fit-agent.png" mode="aspectFit" />
  </view>

  <view class="form card">
    <view class="field">
      <input class="input" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" placeholder="手机号" />
    </view>

    <view class="code-row">
      <view class="field code-field">
        <input class="input" value="{{code}}" bindinput="onCodeInput" type="number" maxlength="6" placeholder="验证码" />
      </view>
      <button class="secondary-btn code-btn" disabled="{{cooldown > 0 || sending}}" bindtap="onSendCode">
        {{cooldown > 0 ? cooldown + 's' : '获取验证码'}}
      </button>
    </view>

    <button class="primary-btn login-btn" loading="{{loading}}" bindtap="onLogin">登录</button>

    <view class="privacy">仅用于健康健身记录与建议，不提供医疗诊断或治疗建议。</view>
  </view>
</view>

