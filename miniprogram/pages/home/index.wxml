<view class="page safe-tab-page home-page">
  <view class="hero">
    <image class="hero-bg" src="/assets/images/fit-chat-background.png" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-content">
      <view class="hello">今天状态</view>
      <view class="date">{{dateLabel}}</view>
    </view>
    <image class="agent" src="/assets/images/female-fit-agent.png" mode="aspectFit" />
  </view>

  <view wx:if="{{!profileCompleted}}" class="profile-alert card" bindtap="goOnboarding">
    <view class="alert-title">完善基础档案以获得更准确建议</view>
    <view class="alert-text">年龄、身高、体重和活动水平会影响估算结果。</view>
  </view>

  <view class="status card">
    <view class="status-head">
      <view class="section-title">今日概览</view>
      <button class="ghost-btn mini" bindtap="goSummary">总结</button>
    </view>
    <view class="stats-grid">
      <view class="stat">
        <text class="value">{{archive ? archive.meal_count : meals.length}}</text>
        <text class="label">餐食</text>
      </view>
      <view class="stat">
        <text class="value">{{archive ? archive.body_metric_count : bodyMetrics.length}}</text>
        <text class="label">身体指标</text>
      </view>
      <view class="stat">
        <text class="value">{{archive && archive.calorie_total ? archive.calorie_total : '--'}}</text>
        <text class="label">kcal</text>
      </view>
      <view class="stat">
        <text class="value">{{archive && archive.protein_total_g ? archive.protein_total_g : '--'}}</text>
        <text class="label">蛋白 g</text>
      </view>
    </view>
    <view class="latest-weight">最近体重：{{latestWeight}}</view>
  </view>

  <view class="quick">
    <button class="quick-btn meal" bindtap="goChat">记录饮食</button>
    <button class="quick-btn weight" bindtap="goChat">记录体重</button>
    <button class="quick-btn agent-btn" bindtap="goChat">问问 Agent</button>
  </view>

  <view class="advice card">
    <view class="section-title">今日建议</view>
    <view class="advice-text">{{suggestion}}</view>
  </view>

  <view class="recent">
    <view class="recent-head">
      <view class="section-title">最近记录</view>
      <button class="ghost-btn mini" bindtap="goRecords">全部</button>
    </view>
    <view wx:if="{{!meals.length && !bodyMetrics.length}}" class="empty card">今天还没有正式记录</view>
    <view wx:for="{{meals}}" wx:key="id" class="record card">
      <view class="record-title">{{item.meal_type}} · {{item.total_calories || '--'}} kcal</view>
      <view class="record-sub">{{item.items.length}} 项食物，蛋白 {{item.total_protein_g || '--'}} g</view>
    </view>
    <view wx:for="{{bodyMetrics}}" wx:key="id" class="record card">
      <view class="record-title">身体指标 · {{item.weight_kg || '--'}} kg</view>
      <view class="record-sub">体脂 {{item.body_fat_percentage || '--'}}%，BMI {{item.bmi || '--'}}</view>
    </view>
  </view>
</view>

