<view class="login-page">
  <view class="login-card">
    <text class="login-title">LetMeFit</text>
    <text class="login-subtitle">你的健康健身管理助手</text>
    <view class="agent-avatar">
      <image src="/assets/female-fit-agent.png" mode="aspectFill" />
    </view>

    <view class="login-form">
      <input class="input-box" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="18" />
      <view class="code-row">
        <input class="input-box code-input" type="number" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" />
        <button class="code-btn {{cooldown > 0 || sending ? 'disabled' : ''}}" bindtap="onSendCode">
          {{cooldown > 0 ? cooldown + 's' : '获取验证码'}}
        </button>
      </view>
      <button class="btn-primary {{!phone || !code || loggingIn ? 'disabled' : ''}}" bindtap="onLogin">登录</button>
    </view>

    <view class="privacy">
      <text>登录即表示同意服务协议和隐私政策</text>
      <text>仅用于健康健身记录与建议，非医疗用途</text>
    </view>
  </view>
</view>
