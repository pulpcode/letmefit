.welcome-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #ffffff;
}

.welcome-bg,
.welcome-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.welcome-mask {
  background: rgba(255, 255, 255, 0.92);
}

.brand-block {
  position: relative;
  padding-top: 406rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-title {
  color: #101828;
  font-size: 72rpx;
  font-weight: 500;
  line-height: 80rpx;
  z-index: 1;
}

.brand-subtitle {
  margin-top: 16rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #06d6a0;
  font-size: 28rpx;
}

.spark {
  font-size: 24rpx;
  font-weight: 600;
}

.brand-orb {
  position: absolute;
  border-radius: 9999rpx;
  opacity: 0.32;
}

.brand-orb.green {
  left: 202rpx;
  top: 456rpx;
  width: 128rpx;
  height: 128rpx;
  background: #06d6a0;
}

.brand-orb.orange {
  right: 198rpx;
  top: 414rpx;
  width: 96rpx;
  height: 96rpx;
  background: #ff6b35;
}

.agent-stack {
  position: relative;
  width: 496rpx;
  height: 224rpx;
  margin: 64rpx auto 0;
}

.agent-polaroid {
  position: absolute;
  width: 224rpx;
  height: 224rpx;
  padding: 0;
  overflow: hidden;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 30rpx rgba(0, 0, 0, 0.1);
}

.agent-polaroid image {
  width: 100%;
  height: 100%;
}

.agent-polaroid.female {
  left: 0;
  transform: rotate(-8deg);
}

.agent-polaroid.male {
  right: 0;
  transform: rotate(8deg);
}

.welcome-copy {
  position: relative;
  margin: 88rpx 64rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.slogan {
  color: #364153;
  font-size: 32rpx;
  line-height: 48rpx;
}

.desc {
  color: #6a7282;
  font-size: 28rpx;
  line-height: 40rpx;
}

.welcome-actions {
  position: relative;
  margin: 64rpx 64rpx 0;
}

.badges {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
  gap: 32rpx;
  color: #99a1af;
  font-size: 24rpx;
}

.badges view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 9999rpx;
}

.green-dot {
  background: #06d6a0;
}

.blue-dot {
  background: #00b4d8;
}

.orange-dot {
  background: #ff6b35;
}
