.summary-hero {
  min-height: 464rpx;
  padding: 56rpx 48rpx 64rpx;
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-date {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}

.summary-metrics {
  margin-top: 16rpx;
  min-height: 184rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.summary-metrics view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
}

.summary-metrics text:last-child {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 56rpx;
}

.summary-content {
  margin-top: -40rpx;
  padding: 0 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.nutrition-card,
.list-card {
  padding: 40rpx;
}

.bars {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.bar-row view:first-child {
  display: flex;
  justify-content: space-between;
  color: #4a5565;
  font-size: 24rpx;
}

.bar-track {
  margin-top: 8rpx;
  height: 16rpx;
  border-radius: 9999rpx;
  background: #f3f4f6;
  overflow: hidden;
}

.bar-fill {
  height: 16rpx;
  border-radius: 9999rpx;
}

.bar-fill.green {
  background: #06d6a0;
}

.bar-fill.blue {
  background: #00b4d8;
}

.bar-fill.orange {
  background: #ff6b35;
}

.suggest-card {
  min-height: 304rpx;
  padding: 40rpx;
  border-radius: 20rpx;
  display: flex;
  gap: 24rpx;
  background: linear-gradient(155deg, #e8f9f5 0%, #e3f2fd 100%);
}

.suggest-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #06d6a0;
  flex-shrink: 0;
}

.suggest-card view {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggest-text {
  color: #364153;
  font-size: 28rpx;
  line-height: 46rpx;
}

.list-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.count {
  color: #6a7282;
  font-size: 28rpx;
}

.summary-item {
  margin-top: 24rpx;
  min-height: 196rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  color: #101828;
  font-size: 28rpx;
}

.summary-item.compact {
  min-height: 112rpx;
}

.summary-item-head {
  display: flex;
  justify-content: space-between;
}

.summary-item-head text:last-child,
.summary-foods {
  color: #6a7282;
  font-size: 24rpx;
}

.small-empty {
  padding: 48rpx 0 8rpx;
  color: #99a1af;
  text-align: center;
  font-size: 28rpx;
}
