.confirm-card {
  padding: 28rpx;
  margin: 24rpx 0;
}

.confirm-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  color: #18332f;
  font-size: 30rpx;
  font-weight: 700;
}

.hint {
  margin-top: 8rpx;
  color: #7a8b87;
  font-size: 24rpx;
}

.confidence {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #0b6f60;
  background: #e7f5f1;
  font-size: 22rpx;
}

.field-row {
  margin-top: 24rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #eef5f3;
  border-bottom: 1rpx solid #eef5f3;
}

.label {
  color: #58716c;
}

.picker-value {
  color: #0b6f60;
  font-weight: 600;
}

.food-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef5f3;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.item-title {
  font-weight: 700;
  color: #18332f;
}

.remove-btn {
  color: #a33a25;
  font-size: 24rpx;
}

.input-line {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.input-label {
  width: 80rpx;
  color: #65827c;
  font-size: 24rpx;
}

.input-label.low {
  color: #b45f06;
}

.line-input {
  flex: 1;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f7fbfa;
}

.macro-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.macro {
  min-width: 0;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f7fbfa;
}

.macro text {
  display: block;
  color: #7a8b87;
  font-size: 22rpx;
}

.macro input {
  margin-top: 8rpx;
  min-height: 44rpx;
  font-size: 24rpx;
}

.add-btn {
  margin-top: 18rpx;
  min-height: 72rpx;
  border-radius: 14rpx;
  color: #0b6f60;
  background: #f0faf7;
  font-weight: 600;
}

.warnings {
  margin-top: 18rpx;
  font-size: 24rpx;
}

.actions {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 14rpx;
}

.small {
  min-height: 76rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
}

