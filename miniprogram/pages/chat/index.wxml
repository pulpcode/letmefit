<view class="chat-page">
  <image class="chat-bg" src="/assets/images/fit-chat-background.png" mode="aspectFill" />
  <view class="chat-mask"></view>

  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollTarget}}">
    <view class="welcome card" wx:if="{{!messages.length && !pendingActions.length}}">
      <image class="welcome-avatar" src="{{agentAvatar === 'female' ? '/assets/images/female-fit-agent.png' : '/assets/images/male-fit-agent.png'}}" mode="aspectFit" />
      <view class="welcome-title">今天想记录什么？</view>
      <view class="welcome-text">可以输入文字、拍餐食、上传图片或录一段语音。</view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" class="message-row {{item.role}}">
      <image wx:if="{{item.role === 'assistant'}}" class="avatar" src="{{agentAvatar === 'female' ? '/assets/images/female-fit-agent.png' : '/assets/images/male-fit-agent.png'}}" mode="aspectFit" />
      <view class="bubble">{{item.text}}</view>
    </view>

    <view class="pending-list" wx:if="{{pendingActions.length}}">
      <block wx:for="{{pendingActions}}" wx:key="pending_action_id">
        <meal-confirm-card
          wx:if="{{item.type === 'create_meal_record'}}"
          action="{{item}}"
          bind:update="onPendingUpdate"
          bind:confirm="onPendingConfirm"
          bind:discard="onPendingDiscard"
        />
        <body-metric-confirm-card
          wx:elif="{{item.type === 'create_body_metric_record'}}"
          action="{{item}}"
          bind:update="onPendingUpdate"
          bind:confirm="onPendingConfirm"
          bind:discard="onPendingDiscard"
        />
        <view wx:else class="unsupported card">暂不支持的候选动作：{{item.type}}</view>
      </block>
    </view>

    <view id="chat-bottom" class="bottom-anchor"></view>
  </scroll-view>

  <view class="composer">
    <view class="tool-row">
      <button class="tool" bindtap="onCamera">拍照</button>
      <button class="tool" bindtap="onAlbum">图片</button>
      <button class="tool {{recording ? 'recording' : ''}}" bindtap="onRecordTap">{{recording ? '停止' : '语音'}}</button>
    </view>
    <view class="input-row">
      <input class="text-input" value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="onSendText" placeholder="输入饮食、体重或想问的问题" />
      <button class="send-btn" loading="{{sending}}" bindtap="onSendText">发送</button>
    </view>
  </view>
</view>

