<view class="page summary-page">
  <view class="header">
    <view class="section-title">每日总结</view>
    <view class="muted">{{date}}</view>
  </view>

  <view class="overview card">
    <view class="metric">
      <text class="value">{{archive ? archive.meal_count : '--'}}</text>
      <text class="label">餐食</text>
    </view>
    <view class="metric">
      <text class="value">{{archive ? archive.body_metric_count : '--'}}</text>
      <text class="label">身体指标</text>
    </view>
    <view class="metric">
      <text class="value">{{archive && archive.calorie_total ? archive.calorie_total : '--'}}</text>
      <text class="label">kcal</text>
    </view>
    <view class="metric">
      <text class="value">{{archive && archive.protein_total_g ? archive.protein_total_g : '--'}}</text>
      <text class="label">蛋白 g</text>
    </view>
  </view>

  <view class="summary-card card">
    <view class="card-title">记录概览</view>
    <view class="summary-text">{{summary ? summary.summary_text : '正在生成今日总结'}}</view>
  </view>

  <view class="summary-card card">
    <view class="card-title">建议</view>
    <view wx:if="{{summary && summary.suggestions.length}}">
      <view wx:for="{{summary.suggestions}}" wx:key="index" class="suggestion">{{item}}</view>
    </view>
    <view wx:else class="summary-text">继续补充记录后，可以生成更具体的建议。</view>
  </view>

  <button class="primary-btn continue" bindtap="goChat">继续记录</button>
</view>

