<view class="chat-page">
  <image class="chat-bg" src="/assets/fit-chat-background.png" mode="aspectFill" />
  <view class="chat-mask"></view>

  <!-- 顶部栏：返回按钮 + 标题 -->
  <view class="chat-header">
    <button class="back-btn" bindtap="onBack" aria-label="返回">
      <text class="back-arrow">‹</text>
    </button>
    <view class="agent-mini-avatar">
      <image src="{{avatarSrc}}" mode="aspectFill" />
    </view>
    <view class="chat-title-block">
      <text class="chat-title">{{pageTitle}}</text>
      <text class="chat-subtitle">健身助手</text>
    </view>
    <button class="nav-icon nav-right" bindtap="onMoreOptions" aria-label="更多">⋮</button>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="message-scroll" style="{{scrollStyle}}" scroll-y scroll-into-view="{{scrollIntoView}}">
    <view class="message-list">
      <view wx:if="{{!chatItems.length}}" class="message-row assistant welcome-message">
        <image class="bubble-avatar" src="{{avatarSrc}}" mode="aspectFill" />
        <view class="bubble">
          <text>你好！我是你的健康健身助手。你可以告诉我今天吃了什么，或者记录体重等身体指标。</text>
        </view>
      </view>

      <block wx:for="{{chatItems}}" wx:key="id">
        <view wx:if="{{item.kind === 'message'}}" class="message-row {{item.role === 'user' ? 'user' : 'assistant'}}">
          <image wx:if="{{item.role === 'assistant'}}" class="bubble-avatar" src="{{avatarSrc}}" mode="aspectFill" />
          <view class="bubble {{item.role === 'assistant' && !item.text ? 'typing-bubble' : ''}} {{item.images && item.images.length ? 'media-bubble' : ''}}">
            <block wx:if="{{item.role === 'assistant' && !item.text}}">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </block>
            <block wx:else>
              <view wx:if="{{item.images && item.images.length}}" class="message-images">
                <image
                  wx:for="{{item.images}}"
                  wx:for-item="image"
                  wx:key="fileId"
                  class="message-image"
                  src="{{image.url}}"
                  mode="aspectFill"
                  data-src="{{image.url}}"
                  data-urls="{{item.imageUrls}}"
                  bindtap="previewChatImage"
                />
              </view>
              <text wx:if="{{item.text}}" class="bubble-text">{{item.text}}</text>
            </block>
          </view>
        </view>
        <view wx:elif="{{item.kind === 'vision_reasoning'}}" class="message-row assistant vision-reasoning-row">
          <image class="bubble-avatar" src="{{avatarSrc}}" mode="aspectFill" />
          <view class="vision-reasoning-card {{item.streaming ? 'vision-streaming' : 'vision-complete'}}">
            <view class="vision-scan-line"></view>
            <view class="vision-reasoning-head">
              <view class="vision-icon-wrap">
                <t-icon name="image-search" size="28rpx" color="#00b4d8" />
              </view>
              <text class="vision-title">{{item.stage}}</text>
              <view wx:if="{{item.streaming}}" class="vision-thinking-dots">
                <view class="vision-dot"></view>
                <view class="vision-dot"></view>
                <view class="vision-dot"></view>
              </view>
              <view wx:else class="vision-done-mark">
                <t-icon name="check" size="22rpx" color="#06a77d" />
              </view>
            </view>
            <text wx:if="{{item.text}}" class="vision-text">{{item.text}}</text>
          </view>
        </view>
        <view wx:elif="{{item.kind === 'pending_action'}}" class="pending-wrap">
          <pending-action-card action="{{item.action}}" bind:confirm="onConfirmAction" bind:discard="onDiscardAction" bind:edit="onEditAction" />
        </view>
        <view wx:elif="{{item.kind === 'pending_action_superseded'}}" class="superseded-wrap">
          <text class="superseded-text">卡片信息已更新</text>
        </view>
      </block>

      <!-- 历史对话压缩中提示 -->
      <view wx:if="{{summaryPending && !sending}}" class="summary-pending-notice">
        <text class="summary-pending-text">历史对话整理中…</text>
      </view>

      <!-- 发送中动态指示（仅在无流式气泡时显示，如语音识别等待期） -->
      <view wx:if="{{sending && !streamingActive}}" class="message-row assistant">
        <image class="bubble-avatar" src="{{avatarSrc}}" mode="aspectFill" />
        <view class="bubble typing-bubble">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>

      <view id="bottom-anchor" class="bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- 输入栏：图片 | 输入框 | 麦克风 | 发送 -->
  <view class="chat-input-bar" style="{{inputBarStyle}}">
    <button class="tool-btn image-entry" bindtap="chooseImageSource" aria-label="图片">
      <t-icon name="logo-instagram" size="42rpx" color="#536171" />
    </button>
    <input
      class="chat-input"
      placeholder="{{inputPlaceholder}}"
      value="{{inputValue}}"
      confirm-type="send"
      adjust-position="{{false}}"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <button
      class="tool-btn voice-btn {{recording ? 'voice-btn-active' : ''}}"
      bindtouchstart="onVoiceTouchStart"
      bindtouchend="onVoiceTouchEnd"
      bindtouchcancel="onVoiceTouchCancel"
      aria-label="语音"
    >
      <t-icon name="microphone" size="42rpx" color="{{recording ? '#ffffff' : '#536171'}}" />
    </button>
    <button class="send-btn {{!inputValue || sending ? 'disabled' : ''}}" bindtap="onSend" aria-label="发送">
      <t-icon name="{{inputValue && !sending ? 'send-filled' : 'send'}}" size="34rpx" color="{{inputValue && !sending ? '#ffffff' : '#6a7282'}}" />
    </button>
  </view>

  <!-- 录音浮层：紧贴输入栏上方的小卡片 -->
  <view wx:if="{{recording}}" class="voice-card {{voiceCancelling ? 'voice-card-cancel' : ''}}" style="{{voiceCardStyle}}">
    <!-- 左侧：波纹 + 麦克风 -->
    <view class="voice-card-left">
      <view class="voice-rings-sm">
        <view class="voice-ring-sm ring-sm1"></view>
        <view class="voice-ring-sm ring-sm2"></view>
        <view class="voice-core-sm">
          <t-icon name="microphone" size="36rpx" color="#ffffff" />
        </view>
      </view>
    </view>

    <!-- 中间：进度条 + 提示 -->
    <view class="voice-card-mid">
      <view class="voice-waveform">
        <view wx:for="{{8}}" wx:key="*this" class="wave-bar bar-{{index}}"></view>
      </view>
      <view class="voice-card-timer-row">
        <view class="voice-timer-bar-sm">
          <view class="voice-timer-fill-sm" style="width: {{voiceProgress}}%"></view>
        </view>
        <text class="voice-timer-text-sm">{{voiceRemain}}s</text>
      </view>
      <text class="voice-card-tip">{{voiceCancelling ? '松手取消' : '松手发送 · 上滑取消'}}</text>
    </view>
  </view>
</view>
