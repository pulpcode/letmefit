.onboarding {
  position: relative;
  min-height: 100vh;
  padding: 96rpx 48rpx 256rpx;
}

.progress {
  display: flex;
  gap: 16rpx;
  height: 8rpx;
}

.progress-seg {
  flex: 1;
  height: 8rpx;
  border-radius: 9999rpx;
  background: #e5e7eb;
}

.progress-seg.active {
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
}

.panel {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
}

.caption {
  margin-top: 16rpx;
  color: #6a7282;
  font-size: 28rpx;
  line-height: 40rpx;
}

.option-list {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-row {
  height: 120rpx;
  border-radius: 20rpx;
  border: 4rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 36rpx;
  color: #4a5565;
  font-size: 32rpx;
  font-weight: 500;
}

.option-row.selected,
.sex-option.selected,
.activity-option.selected {
  border-color: #06d6a0;
  background: #e8f9f5;
  color: #101828;
}

.option-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #99a1af;
  font-size: 24rpx;
}

.field-group {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sex-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.sex-option {
  height: 80rpx;
  border: 4rpx solid #e5e7eb;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4a5565;
  font-size: 28rpx;
  font-weight: 500;
}

.activity-list {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-option {
  height: 160rpx;
  border: 4rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.activity-label {
  color: #4a5565;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.activity-desc {
  color: #99a1af;
  font-size: 24rpx;
  line-height: 32rpx;
}

.bottom-actions {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}
