page {
  min-height: 100%;
  background: #f9fafb;
  color: #101828;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: 0;
}

view,
text,
input,
textarea,
button,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  background: #f9fafb;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-white {
  min-height: 100vh;
  background: #ffffff;
}

.content {
  padding: 0 48rpx;
}

.safe-top {
  padding-top: calc(64rpx + env(safe-area-inset-top));
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.btn-primary {
  height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary.disabled,
.btn-primary[disabled] {
  opacity: 0.5;
  background: linear-gradient(90deg, #d1d5dc 0%, #99a1af 100%);
}

.btn-secondary {
  height: 88rpx;
  border-radius: 20rpx;
  color: #99a1af;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.input-box {
  height: 100rpx;
  border: 2rpx solid #d1d5dc;
  border-radius: 20rpx;
  padding: 0 32rpx;
  color: #101828;
  font-size: 32rpx;
  background: rgba(255, 255, 255, 0.72);
}

.label {
  color: #364153;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.muted {
  color: #6a7282;
}

.subtle {
  color: #99a1af;
}

.section-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.page-title {
  color: #101828;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.gradient-title {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.pill {
  border-radius: 9999rpx;
}

.primary-text {
  color: #06d6a0;
}

.info-text {
  color: #00b4d8;
}

.warning-text {
  color: #ff6b35;
}

.danger-text {
  color: #fb2c36;
}
