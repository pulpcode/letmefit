<view class="page onboarding-page">
  <view class="top">
    <view>
      <view class="step-label">步骤 {{step + 1}} / 3</view>
      <view class="section-title">
        {{step === 0 ? '你的主要目标' : step === 1 ? '基础身体信息' : '活动水平'}}
      </view>
    </view>
    <button class="ghost-btn skip" bindtap="onSkip">稍后完善</button>
  </view>

  <view class="progress">
    <view class="progress-bar" style="width: {{(step + 1) * 33.333}}%;"></view>
  </view>

  <view wx:if="{{step === 0}}" class="option-grid">
    <view
      wx:for="{{goalOptions}}"
      wx:key="value"
      class="option card {{profile.goal_type === item.value ? 'selected' : ''}}"
      data-value="{{item.value}}"
      bindtap="onGoalTap"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view wx:elif="{{step === 1}}" class="form card">
    <view class="sex-row">
      <view
        wx:for="{{sexOptions}}"
        wx:key="value"
        class="sex-chip {{profile.sex === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSexTap"
      >
        {{item.label}}
      </view>
    </view>

    <view class="field-line">
      <text>年龄</text>
      <input value="{{profile.age}}" data-field="age" bindinput="onNumberInput" type="number" placeholder="30" />
    </view>
    <view class="field-line">
      <text>身高 cm</text>
      <input value="{{profile.height_cm}}" data-field="height_cm" bindinput="onNumberInput" type="digit" placeholder="175" />
    </view>
    <view class="field-line">
      <text>当前体重 kg</text>
      <input value="{{profile.current_weight_kg}}" data-field="current_weight_kg" bindinput="onNumberInput" type="digit" placeholder="72.4" />
    </view>
    <view class="field-line">
      <text>目标体重 kg</text>
      <input value="{{profile.target_weight_kg}}" data-field="target_weight_kg" bindinput="onNumberInput" type="digit" placeholder="可选" />
    </view>
  </view>

  <view wx:else class="activity-list">
    <view
      wx:for="{{activityOptions}}"
      wx:key="value"
      class="activity card {{profile.activity_level === item.value ? 'selected' : ''}}"
      data-value="{{item.value}}"
      bindtap="onActivityTap"
    >
      <view class="activity-title">{{item.label}}</view>
      <view class="activity-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="bottom-actions">
    <button wx:if="{{step > 0}}" class="secondary-btn" bindtap="onPrev">上一步</button>
    <button wx:if="{{step < 2}}" class="primary-btn" bindtap="onNext">下一步</button>
    <button wx:else class="primary-btn" loading="{{saving}}" bindtap="onComplete">完成</button>
  </view>
</view>

