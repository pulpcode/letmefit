<view class="sessions-page page">
  <!-- 顶部标题栏 -->
  <view class="sessions-header" style="padding-right: {{capsuleSafeRight}}rpx">
    <text class="page-title">对话</text>
    <button class="new-session-btn" bindtap="onNewSession" aria-label="新建会话">
      <t-icon name="add" size="44rpx" color="#ffffff" />
    </button>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="sessions-loading">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!conversations.length}}" class="sessions-empty">
    <image src="/assets/female-fit-agent.png" class="empty-avatar" mode="aspectFit" />
    <text class="empty-title">还没有对话</text>
    <text class="empty-desc">点击右上角开始第一次对话吧</text>
    <button class="btn-primary start-btn" bindtap="onNewSession">开始对话</button>
  </view>

  <!-- 会话列表 -->
  <scroll-view wx:else scroll-y class="sessions-list" enhanced>
    <view
      wx:for="{{conversations}}"
      wx:key="id"
      class="session-item {{item.deleting ? 'deleting' : ''}}"
      bindtap="onOpenSession"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
      bindlongpress="onLongPressSession"
    >
      <!-- 会话图标 -->
      <view class="session-icon-wrap">
        <view class="session-icon {{item.iconColor}}">
          <text class="session-icon-text">💬</text>
        </view>
      </view>

      <!-- 会话信息 -->
      <view class="session-info">
        <view class="session-info-top">
          <text class="session-title">{{item.title || '新对话'}}</text>
          <text class="session-time">{{item.timeLabel}}</text>
        </view>
        <text class="session-preview">{{item.preview || '暂无消息'}}</text>
      </view>

      <!-- 箭头 -->
      <text class="session-chevron">›</text>
    </view>

    <view class="sessions-list-bottom"></view>
  </scroll-view>

  <!-- 长按操作菜单 -->
  <view wx:if="{{actionSheetVisible}}" class="action-overlay" bindtap="onCloseActionSheet">
    <view class="action-sheet" catchtap>
      <view class="action-sheet-title">{{actionSheetTitle}}</view>
      <button class="action-item action-enter" bindtap="onActionEnter">进入对话</button>
      <button class="action-item action-delete" bindtap="onActionDelete">删除会话</button>
      <button class="action-item action-cancel" bindtap="onCloseActionSheet">取消</button>
    </view>
  </view>
</view>
