.sessions-page {
  min-height: 100vh;
  background: #f9fafb;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ========== 顶部标题栏 ========== */
.sessions-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(32rpx + env(safe-area-inset-top)) 40rpx 32rpx;
}

.new-session-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #06d6a0 0%, #00b4d8 100%);
  box-shadow: 0 4rpx 12rpx rgba(6, 214, 160, 0.3);
}


/* ========== 加载态 ========== */
.sessions-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #06d6a0;
  animation: bounce 1.2s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
  background: #00b4d8;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
  background: #99a1af;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* ========== 空状态 ========== */
.sessions-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 64rpx;
}

.empty-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 9999rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #101828;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #99a1af;
  text-align: center;
  margin-bottom: 56rpx;
  line-height: 44rpx;
}

.start-btn {
  width: 400rpx;
}

/* ========== 会话列表 ========== */
.sessions-list {
  height: calc(100vh - 240rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
}

.session-item {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 40rpx;
  background: #ffffff;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.session-item:active {
  opacity: 0.75;
  transform: scale(0.985);
}

.session-item.deleting {
  opacity: 0.4;
}

/* 会话图标 */
.session-icon-wrap {
  flex-shrink: 0;
}

.session-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-green  { background: rgba(6, 214, 160, 0.15); }
.icon-blue   { background: rgba(0, 180, 216, 0.15); }
.icon-teal   { background: rgba(20, 184, 166, 0.15); }
.icon-purple { background: rgba(139, 92, 246, 0.15); }
.icon-orange { background: rgba(255, 107, 53, 0.15); }

.session-icon-text {
  font-size: 40rpx;
}

/* 会话文字区域 */
.session-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.session-info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.session-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #101828;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  font-size: 24rpx;
  color: #99a1af;
  flex-shrink: 0;
}

.session-preview {
  font-size: 26rpx;
  color: #6a7282;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-chevron {
  font-size: 40rpx;
  color: #d1d5dc;
  flex-shrink: 0;
  line-height: 1;
}

.sessions-list-bottom {
  height: 40rpx;
}

/* ========== 长按操作菜单 ========== */
.action-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.action-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.action-sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: #99a1af;
  padding: 36rpx 40rpx 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.action-enter { color: #101828; }

.action-delete { color: #fb2c36; }

.action-cancel {
  color: #99a1af;
  border-bottom: none;
  margin-top: 16rpx;
}
