<view class="confirm-card card">
  <view class="confirm-head">
    <view>
      <view class="title">身体指标待确认</view>
      <view class="hint">这是候选结果，请确认后保存</view>
    </view>
    <view class="confidence">置信度 {{confidenceText}}</view>
  </view>

  <view class="metric-list">
    <view class="input-line">
      <text class="input-label {{warningFields.indexOf('weight_kg') >= 0 ? 'low' : ''}}">体重 kg</text>
      <input class="line-input" value="{{draft.weight_kg}}" data-field="weight_kg" bindinput="onInput" type="digit" placeholder="72.4" />
    </view>
    <view class="input-line">
      <text class="input-label {{warningFields.indexOf('body_fat_percentage') >= 0 ? 'low' : ''}}">体脂率</text>
      <input class="line-input" value="{{draft.body_fat_percentage}}" data-field="body_fat_percentage" bindinput="onInput" type="digit" placeholder="可选" />
    </view>
    <view class="input-line">
      <text class="input-label {{warningFields.indexOf('bmi') >= 0 ? 'low' : ''}}">BMI</text>
      <input class="line-input" value="{{draft.bmi}}" data-field="bmi" bindinput="onInput" type="digit" placeholder="可选" />
    </view>
    <view class="input-line">
      <text class="input-label">记录时间</text>
      <input class="line-input" value="{{draft.recorded_at}}" data-field="recorded_at" bindinput="onInput" placeholder="ISO 时间" />
    </view>
  </view>

  <view class="warnings" wx:if="{{warningFields.length}}">
    <text class="low-confidence">有低置信度字段，请确认数值后保存</text>
  </view>

  <view class="actions">
    <button class="secondary-btn small" bindtap="onUpdate">修改</button>
    <button class="primary-btn small" bindtap="onConfirm">确认保存</button>
    <button class="danger-btn small" bindtap="onDiscard">放弃</button>
  </view>
</view>

