.profile-hero {
  height: 240rpx;
  padding: 76rpx 48rpx 0;
  background: linear-gradient(90deg, #06d6a0 0%, #00b4d8 100%);
}

.profile-content {
  margin-top: -32rpx;
  padding: 0 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.avatar-card {
  padding: 40rpx;
}

.avatar-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
}

.avatar-option {
  height: 256rpx;
  border-radius: 20rpx;
  border: 4rpx solid #e5e7eb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #101828;
  font-size: 28rpx;
  font-weight: 500;
}

.avatar-option.selected {
  border-color: #06d6a0;
  background: #e8f9f5;
}

.avatar-option image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 9999rpx;
}

.info-card {
  overflow: hidden;
}

.info-head {
  height: 114rpx;
  padding: 0 40rpx;
  border-bottom: 2rpx solid #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-head button {
  color: #06d6a0;
  font-size: 28rpx;
  font-weight: 500;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  height: 106rpx;
  padding: 0 40rpx;
  border-bottom: 2rpx solid #f3f4f6;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.row-icon {
  width: 40rpx;
  color: #99a1af;
  font-size: 40rpx;
}

.row-label {
  flex: 1;
  color: #4a5565;
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  color: #101828;
  font-size: 28rpx;
  font-weight: 500;
}

.chevron {
  color: #99a1af;
  font-size: 40rpx;
}

.logout-card {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.version {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #99a1af;
  font-size: 24rpx;
  line-height: 40rpx;
}
