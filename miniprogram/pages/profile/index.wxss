.header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
}

.form,
.agent-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.field-line {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #eef5f3;
}

.field-line:first-child {
  border-top: 0;
}

.field-line text {
  color: #58716c;
}

.field-line input {
  flex: 1;
  text-align: right;
  color: #18332f;
}

.field-line picker {
  color: #0b6f60;
  font-weight: 600;
}

.card-title {
  color: #18332f;
  font-weight: 700;
}

.agent-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.agent-option {
  min-height: 180rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e2eeea;
  border-radius: 16rpx;
  background: #f7fbfa;
  color: #58716c;
}

.agent-option image {
  width: 110rpx;
  height: 110rpx;
}

.agent-option text {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.agent-option.selected {
  border-color: rgba(11, 143, 122, 0.48);
  background: #e7f5f1;
  color: #0b6f60;
}

.save {
  margin-top: 28rpx;
}

.logout {
  margin-top: 18rpx;
}

