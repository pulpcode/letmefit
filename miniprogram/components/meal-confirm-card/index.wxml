<view class="confirm-card card">
  <view class="confirm-head">
    <view>
      <view class="title">餐食记录待确认</view>
      <view class="hint">请确认后保存，AI 结果还不是正式记录</view>
    </view>
    <view class="confidence">置信度 {{confidenceText}}</view>
  </view>

  <view class="field-row">
    <text class="label">餐别</text>
    <picker mode="selector" range="{{mealTypes}}" range-key="label" value="{{mealTypeIndex}}" bindchange="onMealTypeChange">
      <view class="picker-value">{{mealTypes[mealTypeIndex].label}}</view>
    </picker>
  </view>

  <view class="items">
    <view class="food-item" wx:for="{{draft.items}}" wx:key="index">
      <view class="item-top">
        <text class="item-title">食物 {{index + 1}}</text>
        <button class="remove-btn" data-index="{{index}}" bindtap="onRemoveItem">删除</button>
      </view>

      <view class="input-line">
        <text class="input-label {{warningFields.indexOf('name') >= 0 ? 'low' : ''}}">名称</text>
        <input class="line-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onItemInput" placeholder="食物名称" />
      </view>

      <view class="input-line">
        <text class="input-label {{warningFields.indexOf('portion_text') >= 0 || warningFields.indexOf('portion_grams') >= 0 ? 'low' : ''}}">份量</text>
        <input class="line-input" value="{{item.portion_text}}" data-index="{{index}}" data-field="portion_text" bindinput="onItemInput" placeholder="约120g" />
      </view>

      <view class="macro-grid">
        <view class="macro">
          <text>热量</text>
          <input value="{{item.calories}}" data-index="{{index}}" data-field="calories" bindinput="onItemInput" type="digit" placeholder="kcal" />
        </view>
        <view class="macro">
          <text>蛋白</text>
          <input value="{{item.protein_g}}" data-index="{{index}}" data-field="protein_g" bindinput="onItemInput" type="digit" placeholder="g" />
        </view>
        <view class="macro">
          <text>碳水</text>
          <input value="{{item.carbs_g}}" data-index="{{index}}" data-field="carbs_g" bindinput="onItemInput" type="digit" placeholder="g" />
        </view>
        <view class="macro">
          <text>脂肪</text>
          <input value="{{item.fat_g}}" data-index="{{index}}" data-field="fat_g" bindinput="onItemInput" type="digit" placeholder="g" />
        </view>
      </view>
    </view>
  </view>

  <button class="add-btn" bindtap="onAddItem">添加食物</button>

  <view class="warnings" wx:if="{{warningFields.length}}">
    <text class="low-confidence">有低置信度字段，请重点确认份量和营养估算</text>
  </view>

  <view class="actions">
    <button class="secondary-btn small" bindtap="onUpdate">修改</button>
    <button class="primary-btn small" bindtap="onConfirm">确认保存</button>
    <button class="danger-btn small" bindtap="onDiscard">放弃</button>
  </view>
</view>

